import yfinance as yf
import pandas as pd
from sklearn.linear_model import LinearRegression
import numpy as np

def working_capital_trends_sigmoid():
    ticker = input("Enter stock ticker (e.g. CAT, GE, MMM): ").strip().upper()
    stock = yf.Ticker(ticker)

    # Grab balance sheet (transpose for easier access)
    try:
        bs = stock.balance_sheet.T
    except:
        print(f" Could not fetch balance sheet for {ticker}")
        return

    current_assets_candidates = ["Total Current Assets", "Current Assets"]
    current_liabilities_candidates = ["Total Current Liabilities", "Current Liabilities"]

    def get_series(df, candidates):
        for c in candidates:
            if c in df.columns:
                return df[c].dropna()
        return pd.Series(dtype=float)

    current_assets = get_series(bs, current_assets_candidates)
    current_liabilities = get_series(bs, current_liabilities_candidates)

    if current_assets.empty or current_liabilities.empty:
        print(f" Missing Current Assets or Liabilities data for {ticker}")
        return

    nwc = current_assets - current_liabilities
    df = pd.DataFrame({
        "Current Assets": current_assets,
        "Current Liabilities": current_liabilities,
        "Net Working Capital": nwc
    })
    print(f"\n📊 Working Capital Trends for {ticker}:\n")
    print(df.round(2))

    # Linear regression for trend
    X = np.arange(len(nwc)).reshape(-1, 1)
    y = nwc.values
    model = LinearRegression().fit(X, y)
    slope = model.coef_[0]

    future_X = np.arange(len(nwc), len(nwc) + 5).reshape(-1, 1)
    nwc_forecast = model.predict(future_X)
    forecast_df = pd.DataFrame({"Net Working Capital Forecast": nwc_forecast})
    print(f"\n🔮 Net Working Capital Forecast for next 5 periods:\n")
    print(forecast_df.round(2))

    # --- Target slope (adjusted for mature industrial companies) ---
    revenue_candidates = ["Total Revenue", "Revenues", "Operating Revenue", "Net Sales", "Revenue"]
    revenue = None
    for r in revenue_candidates:
        if r in stock.financials.index:
            revenue = stock.financials.loc[r].iloc[0]
            break
    if revenue is None:
        revenue = 1e10  # fallback

    # Target slope = 3% of revenue for mature industrials
    target_slope = 0.03 * revenue

    # --- Sigmoid scoring ---
    k = 5  # steepness factor
    score = 100 / (1 + np.exp(-k * (slope - target_slope) / target_slope))
    score = round(score, 2)

    print(f"\n Working Capital Trend Score (0-100) for {ticker}: {score}")

working_capital_trends_sigmoid()
